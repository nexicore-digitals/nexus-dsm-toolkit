{
    "name": "nexus-dsm",
    "version": "2.0.0",
    "description": "Modular toolkit for parsing, validating, and converting structured datasets (CSV ↔ JSON) with reviewer clarity.",
    "type": "module",
    "license": "MIT",
    "private": false,
    "author": "Owen • Nexicore Digital",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "node_deb": {
        "executable_name": "nexus-dsm",
        "install_dir": "/usr/bin",
        "maintainer": "Owen • Nexicore Digital",
        "description": "Modular toolkit for parsing, validating, and converting structured datasets (CSV ↔ JSON) with reviewer clarity.",
        "license": "MIT",
        "version": "2.0.0",
        "entrypoints": {
            "daemon": "/usr/bin/nexus-dsm"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nexicore-digitals/nexus-dsm-toolkit.git"
    },
    "keywords": [
        "csv",
        "json",
        "parser",
        "dataset",
        "validator",
        "node",
        "typescript",
        "conversion",
        "metadata",
        "cli-toolkit",
        "nexus",
        "nexicore",
        "nexicore digitals"
    ],
    "contributors": [
        {
            "name": "Owen",
            "email": "erhaborowen3@gmail.com",
            "url": "https://github.com/owen-6936"
        }
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "dev": "tsx src/index.ts",
        "example:csv": "tsx examples/parse-csv.ts",
        "example:json": "tsx examples/parse-json.ts",
        "example:to-csv": "tsx examples/convert-to-csv.ts",
        "example:to-json": "tsx examples/convert-to-json.ts",
        "prepare": "husky",
        "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup ./cli.ts --format esm,cjs",
        "lint": "eslint . --ext .ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write --cache .",
        "test:staged": "vitest run --changed --passWithNoTests",
        "test:node": "node --loader tsx src/index.ts",
        "checks": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
        "nexus-dsm": "pnpm exec tsx ./dist/cli.ts",
        "build-deb": "pnpm exec node-deb --init auto -- ."
    },
    "bin": {
        "nexus-dsm": "./dist/cli.cjs"
    },
    "lint-staged": {
        "*.ts": [
            "pnpm format",
            "pnpm lint",
            "pnpm test:staged"
        ],
        "*.{json,md,yml}": [
            "pnpm format"
        ]
    },
    "dependencies": {
        "@types/node": "^24.10.0",
        "ora": "^9.0.0",
        "papaparse": "^5.5.3",
        "winston": "^3.18.3",
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@types/jsonstream": "^0.8.33",
        "@types/papaparse": "^5.3.16",
        "@types/yargs": "^17.0.34",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "eslint": "^9.38.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-vitest": "^0.5.4",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.4",
        "node-deb": "^0.10.7",
        "prettier": "^3.6.2",
        "tsup": "^8.5.0",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.44.0",
        "vitest": "^3.2.4"
    }
}
